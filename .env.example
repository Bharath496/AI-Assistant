# AI Assistant Configuration

## Backend API
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=False

## LLM Configuration
# Hugging Face (recommended - free serverless inference, no install)
# Get a free token: https://huggingface.co/settings/tokens
LLM_PROVIDER=huggingface
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
HUGGINGFACE_API_KEY=your_hf_token_here
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# Optional: local Ollama (needs install + model download)
# LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Optional cloud providers
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

## Memory & Storage
SQLITE_DB_PATH=./data/memory.db
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

## Tool Integrations (optional)
TAVILY_API_KEY=your_tavily_key_here
GOOGLE_API_KEY=your_google_key_here
GOOGLE_CALENDAR_ID=your_calendar_id_here
NOTION_API_KEY=your_notion_key_here
NOTION_DATABASE_ID=your_notion_db_id_here

## CORS (allowed origins for API access)
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000","http://127.0.0.1:8000","https://aiass-akx.pages.dev"]

## Frontend
FRONTEND_URL=http://localhost:5173
